+//proc info
+int getpinfo(uint64 stataddr){
+  struct proc *p;
+  struct pstat st;
+  int pcount=0;
+
+  for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    st.pid[pcount]=p->pid;
+    st.inuse[pcount]= p->state == RUNNABLE || p->state == RUNNING;
+    st.inQ[pcount]=p->queueno;
+    st.tickets_original[pcount]=p->oritktcnt;
+    st.tickets_current[pcount]=p->curtktcnt;
+    st.time_slices[pcount]=p->totaltimeslot;
+    release(&p->lock);
+    pcount++;
+  }
+  p=myproc();
+  if(copyout(p->pagetable, stataddr, (char *)&st, sizeof(st)) < 0)
+      return -1;
+
+  return 0;
+}
+
+
+int gettotaltickets(){
+    struct proc *p;
+    int tkt=0;
+    int flag = 0;
+    for(p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+      if(p->queueno==1 && p->state == RUNNABLE){
+        tkt+=p->curtktcnt;
+        flag = 1;
+      }
+      release(&p->lock);
+    }
+    if(!flag) return -1;
+    return tkt;
+}
+
+int rand(int bound){  
+  return genrand()%bound;
+}
+
+void reinittkt(){
+  struct proc *p;
+    for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if(p->state==RUNNABLE)
+      p->curtktcnt=p->oritktcnt;
+    release(&p->lock);
+  }
+}
+
+void boostproc(){
+  struct proc *p;
+  for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if(p->queueno == 2){
+      p->queueno=1;
+    }
+    release(&p->lock);
+  }
+}
+
+void
+upd_clock() {
+  struct proc *p;
+  for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if(p->state == RUNNING) {
+      p->totaltimeslot++;
+      p->curtimeslot++;
+    }
+    release(&p->lock);
+  }
+}
