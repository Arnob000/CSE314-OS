   return xticks;
 }
+
+
+//set ticket
+uint64
+sys_settickets(void){
+  int tkt;
+  struct proc *p=myproc();
+
+  argint(0, &tkt);
+  if(tkt<=0){
+    acquire(&p->lock);
+    p->oritktcnt=DEFAULT_TICKET_COUNT;
+    p->curtktcnt=DEFAULT_TICKET_COUNT;
+    release(&p->lock);
+    return -1;
+  }
+  
+  acquire(&p->lock);
+  p->curtktcnt=tkt;
+  p->oritktcnt=tkt;
+  release(&p->lock);
+  return 0;
+  
+}
+
+//get proc stat
+uint64
+sys_getpinfo(void)
+{  
+  uint64 stataddr;
+  argaddr(0, &stataddr);
+  return getpinfo(stataddr);  
+}
