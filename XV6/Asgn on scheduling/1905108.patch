+#include "kernel/stat.h"
+#include "kernel/pstat.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+  struct pstat procstat;
+  
+  if(argc > 1){
+    fprintf(2, "Usage: %s\n", argv[0]);
+    exit(1);
+  }
+
+  
+  if(getpinfo(&procstat)<0){
+      fprintf(2, "%s: fetching proc info failed\n", argv[0]);
+      exit(1);
+  }
+  
+
+  fprintf(2,"PID\t|\tIN USE\t|\tinQ\t| ORIGINAL TICKETS | CURRENT TICKETS | TIME SLICES\n");
