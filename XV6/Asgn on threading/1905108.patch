+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "user/thread_spinlock.h"
+#include "user/thread_mutex.h"
+
+struct balance {
+    char name[32];
+    int amount;
+};
+
+volatile int total_balance = 0;
+struct thread_spinlock lock;
+struct thread_mutex mlock;
+struct thread_mutex consol;
+
+
+volatile unsigned int delay (unsigned int d) {
+   unsigned int i;
+   for (i = 0; i < d; i++) {
+       __asm volatile( "nop" ::: );
+   }
+
+   return i;
+}
+
+void new_work(void *arg){
+    struct balance *b = (struct balance*) arg;
+    for(int i=0; i<3; i++){
+        thread_mutex_lock(&consol);
+        printf("I am new %s\n",b->name);
+        thread_mutex_unlock(&consol);
+    }
+    thread_exit();
+}
+
+void do_work(void *arg){
+    int i;
+    int old;
+
+    int* t=malloc(4096);
+    *t=20;
+
+    struct balance *b = (struct balance*) arg;
+    thread_mutex_lock(&consol);
+    printf("Starting do_work(%d): s:%s\n",*t , b->name);
+    thread_mutex_unlock(&consol);
+
+    for (i = 0; i < b->amount; i++) {
+        // lock and mlock will be implemented by you.
+        //  thread_spin_lock(&lock);
+         thread_mutex_lock(&mlock);
+         old = total_balance;
+         delay(100000);
+	 if(old != total_balance)  printf("we will miss an update. old: %d total_balance: %d\n", old, total_balance);
+         total_balance = old + 1;
+        //  thread_spin_unlock(&lock);
+         thread_mutex_unlock(&mlock);
+
+    }
+
+    void *s1=malloc(4096);
+    int thread1,r1;
+
+    thread1 = thread_create(new_work, (void*)b, s1);
+
+    r1 = thread_join(thread1);
+
+
+    printf( "Done s:%x \n%d\n", b->name, r1);
+
+    thread_exit();
+    return;
+}
+
+int main(int argc, char *argv[]) {
+
+  struct balance b1 = {"b1", 3200};
+  struct balance b2 = {"b2", 2800};
+  struct balance b3 = {"b3", 2000};
+
+  void *s1, *s2, *s3;
+  int thread1, thread2,thread3, r1, r2,r3;
+  thread_spin_init(&lock,"thlock");
+  thread_mutex_init(&mlock,"thlock");
+  thread_mutex_init(&consol,"console");
+
+  s1 = malloc(4096); // 4096 is the PGSIZE defined in kernel/riscv.h
+  s2 = malloc(4096);
+  s3 = malloc(4096);
+
+  thread1 = thread_create(do_work, (void*)&b1, s1);
+  thread2 = thread_create(do_work, (void*)&b2, s2);
+  thread3 = thread_create(do_work, (void*)&b3, s3);
+
+  r1 = thread_join(thread1);
+  r2 = thread_join(thread2);
+  r3 = thread_join(thread3);
+
+  printf("Threads finished: (%d):%d, (%d):%d, (%d):%d, shared balance:%d\n",
+      thread1, r1, thread2, r2,thread3, r3, total_balance);
+
+  exit(0);
+}
