diff --git a/user/queue.h b/user/queue.h
new file mode 100644
index 0000000..9b4f598
--- /dev/null
+++ b/user/queue.h
@@ -0,0 +1,31 @@
+struct queue {
+    int arr[64];
+    int front;
+    int rear;
+    int size;
+};
+
+void initqueue(struct queue* q) {
+    q->front = 0;
+    q->rear = 0;
+    q->size = 0;
+}
+
+void push(struct queue* q, int x) {
+    q->arr[q->rear] = x;
+    q->rear = (q->rear + 1) % 64;
+    q->size++;
+}
+
+int getfront(struct queue* q) {
+    if (q->size == 0)
+        return -1;
+    return q->arr[q->front];
+}
+
+void pop(struct queue* q) {
+    if (q->size != 0) {
+        q->front = (q->front + 1) % 64;
+        q->size--;
+    }
+}
diff --git a/user/semaphore.h b/user/semaphore.h
new file mode 100644
index 0000000..ccf7860
--- /dev/null
+++ b/user/semaphore.h
@@ -0,0 +1,32 @@
+//counting semaphore
+#include "user/conditional.h"
+
+typedef struct sem_t {
+    int count;
+    struct thread_mutex m;
+    struct conditional cv;
+} sem_t;
+
+int sem_init(sem_t *s, int value) {
+    s->count = value;
+    thread_mutex_init(&s->m, "mutex");
+    conditional_init(&s->cv);
+    return 0;
+}
+
+void sem_post(sem_t *s) {
+    thread_mutex_lock(&s->m);
+    s->count++;
+    if (s->count == 1)
+        conditional_signal(&s->cv); // A woken thread must acquire the lock, so it will also have to wait until we call unlock
+    thread_mutex_unlock(&s->m);
+}
+
+void sem_wait(sem_t *s) {
+    thread_mutex_lock(&s->m);
+    while (s->count == 0) {
+        conditional_wait(&s->cv, &s->m); //unlock mutex, wait, relock mutex
+    }
+    s->count--;
+    thread_mutex_unlock(&s->m);
+}
