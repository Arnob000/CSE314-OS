diff --git a/user/conditional.h b/user/conditional.h
new file mode 100644
index 0000000..29f9184
--- /dev/null
+++ b/user/conditional.h
@@ -0,0 +1,52 @@
+#include "user/thread_spinlock.h"
+#include "user/thread_mutex.h"
+#include "user/queue.h"
+
+struct conditional{
+    struct queue q;
+    struct thread_spinlock queuelock;
+};
+
+void conditional_init(struct conditional* cv){
+    initqueue(&(cv->q));
+    thread_spin_init(&(cv->queuelock),"queuelock");
+}
+
+void conditional_wait(struct conditional* cv, struct thread_mutex* lock){
+    thread_spin_lock(&(cv->queuelock));
+    push(&(cv->q), getpid());
+    thread_spin_unlock(&(cv->queuelock));
+
+    //releases lock and suspends thyself
+    lock->procid = 0;
+    atomic_suspend(&(lock->locked));
+    thread_mutex_lock(lock);
+}
+
+void conditional_signal(struct conditional* cv)
+{
+    int pid;
+
+    thread_spin_lock(&(cv->queuelock));
+    pid = getfront(&(cv->q)); //isempty then tid=-1
+    pop(&(cv->q));
+    thread_spin_unlock(&(cv->queuelock));
+
+    if (pid>0) //wake up
+        resume(pid);
+}
+
+
+void conditional_broadcast(struct conditional* cv)
+{
+    int pid;
+
+    thread_spin_lock(&(cv->queuelock));
+    while (getfront(&(cv->q))>0) //isempty then tid=-1
+    {
+        pid = getfront(&(cv->q));
+        pop(&(cv->q));
+        resume(pid);
+    }
+    thread_spin_unlock(&(cv->queuelock));
+}
