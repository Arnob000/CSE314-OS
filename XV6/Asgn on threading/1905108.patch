+	sem_init(&full,0);
+}
+
+void ProducerFunc(void * arg)
+{
+	thread_mutex_lock(&consol);
+    printf("%s\n", (char*)arg);
+    thread_mutex_unlock(&consol);
+
+	int i;
+	for(i=1;i<=20;i++)
+	{
+		sem_wait(&empty);
+		thread_mutex_lock(&mutex);
+
+		sleep(1);
+		push(&q,i);
+		thread_mutex_lock(&consol);
+        printf("producer produced item %d\n", i);
+        thread_mutex_unlock(&consol);
+
+		thread_mutex_unlock(&mutex);
+		sem_post(&full);
+	}
+	thread_exit();
+}
+
+void ConsumerFunc(void * arg)
+{
+	thread_mutex_lock(&consol);
+    printf("i am %s\n", (char*)arg);
+    thread_mutex_unlock(&consol);
+
+	int i;
+	for(i=1;i<=10;i++)
+	{
+		sem_wait(&full);
+		thread_mutex_lock(&mutex);
+
+		sleep(1);
+		int item = getfront(&q);
+		pop(&q);
+		thread_mutex_lock(&consol);
+        printf("%s consumed item %d\n", (char*)arg, item);
+        thread_mutex_unlock(&consol);
+
+		sem_post(&empty);
+		thread_mutex_unlock(&mutex);
+	}
+	thread_exit();
+}
+
+int main(void)
+{
+	init_semaphore();
+	initqueue(&q);
+
+	char * message1 = "i am producer";
+	char * message2 = "consumer1";
+	char * message3 = "consumer2";
+
+	void *s1, *s2, *s3;
