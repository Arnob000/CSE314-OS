+void
+atomic_suspend(uint64 lk)
+{
+  struct proc *p = myproc();
+
+  // Once we hold p->lock, we can be
+  // guaranteed that we won't miss any wakeup
+  // cause wakeup locks p->lock
+  // so it's okay to release lk.
+
+  acquire(&p->lock);  //DOC: sleeplock1
+  acquire(p->memlock);
+  atomicrelease(p->pagetable, lk);
+  release(p->memlock);
+
+  // Go to sleep.
+  p->state = SLEEPING;
+  sched();
+
+  release(&p->lock);
+  // acquire(lk);
+}
+
+//resume suspended thread
+void
+resume(int pid)
+{
+  struct proc *p;
+
+  for(p = proc; p < &proc[NPROC]; p++) {
+    if(p != myproc()){
+      acquire(&p->lock);
+      if(p->state == SLEEPING && p->pid == pid) {
+        p->state = RUNNABLE;
+      }
+      release(&p->lock);
+    }
+  }
+}
