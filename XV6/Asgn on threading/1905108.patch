diff --git a/user/procon.c b/user/procon.c
new file mode 100644
index 0000000..e1bbe9c
--- /dev/null
+++ b/user/procon.c
@@ -0,0 +1,104 @@
+//conditional variable version
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+#include "user/conditional.h"
+
+#define MAX_SIZE 100
+
+int buffer[MAX_SIZE];
+int front = 0;
+int rear = 0;
+
+struct thread_mutex mutex;
+struct conditional full;
+struct conditional empty;
+struct thread_mutex consol;
+
+void init_semaphore() {
+    thread_mutex_init(&mutex,"mutex");
+    thread_mutex_init(&consol,"console");
+    conditional_init(&full);
+    conditional_init(&empty);
+}
+
+void prod(int item) {
+    thread_mutex_lock(&mutex);
+    while ((rear + 1) % MAX_SIZE == front) {
+        conditional_wait(&full, &mutex);
+    }
+    buffer[rear] = item;
+    rear = (rear + 1) % MAX_SIZE;
+    conditional_signal(&empty);
+    thread_mutex_unlock(&mutex);
+}
+
+int con() {
+    thread_mutex_lock(&mutex);
+    while (front == rear) {
+        conditional_wait(&empty, &mutex);
+    }
+    int item = buffer[front];
+    front = (front + 1) % MAX_SIZE;
+    conditional_signal(&full);
+    thread_mutex_unlock(&mutex);
+    return item;
+}
+
+void ProducerFunc(void* arg) {
+    thread_mutex_lock(&consol);
+    printf("%s\n", (char*)arg);
+    thread_mutex_unlock(&consol);
+
+    int i;
+    for (i = 1; i <= 20; i++) {
+        sleep(1);
+        prod(i);
+
+        thread_mutex_lock(&consol);
+        printf("producer produced item %d\n", i);
+        thread_mutex_unlock(&consol);
+    }
+    thread_exit();
+}
+
+void ConsumerFunc(void* arg) {
+    thread_mutex_lock(&consol);
+    printf("i am %s\n", (char*)arg);
+    thread_mutex_unlock(&consol);
+
+    int i;
+    for (i = 1; i <= 10; i++) {
+        sleep(1);
+        int item = con();
+
+        thread_mutex_lock(&consol);
+        printf("%s consumed item %d\n", (char*)arg, item);
+        thread_mutex_unlock(&consol);
+    }
+    thread_exit();
+}
+
+int main(void) {
+    init_semaphore();
+    char* message1 = "i am producer";
+    char* message2 = "consumer1";
+    char* message3 = "consumer2";
+    void *s1, *s2, *s3;
+    int thread1, thread2,thread3, r1, r2,r3;
+
+    s1 = malloc(4096);
+    s2 = malloc(4096);
+    s3 = malloc(4096);
+    thread1 = thread_create(ProducerFunc, (void*)message1, s1);
+    thread2 = thread_create(ConsumerFunc, (void*)message2, s2);
+    thread3 = thread_create(ConsumerFunc, (void*)message3, s3);
+    r1=thread_join(thread1);
+    r2=thread_join(thread2);
+    r3=thread_join(thread3);
+
+    printf("Threads finished: (%d):%d, (%d):%d, (%d):%d\n",
+      thread1, r1, thread2, r2, thread3, r3);
+
+    exit(0);
+}
